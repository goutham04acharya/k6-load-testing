{
  "name": "load-testing-k6-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Load Testing k6: API, workflow Lambdas, runner and the loadtest CLI",
  "type": "module",
  "bin": {
    "loadtest": "./dist/cli/loadtest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1176.0",
    "@aws-sdk/client-ecs": "^3.1176.0",
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/client-sfn": "^3.1176.0",
    "@aws-sdk/client-ssm": "^3.1176.0",
    "@aws-sdk/lib-dynamodb": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
